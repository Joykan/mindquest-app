<mxfile host="app.diagrams.net"><diagram id="gam" name="Gamification mechanics"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;MindQuest – gamification mechanics&lt;/b&gt; &lt;span style=&#x27;font-size:14px;color:#595959&#x27;&gt;(CIT 409 · FR 3, UC-03)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;A. How users earn XP&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="600" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Action" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEDAFF;strokeColor=#8F7FEE;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="36" as="geometry"/></mxCell><mxCell id="c6" value="XP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEDAFF;strokeColor=#8F7FEE;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="90" height="36" as="geometry"/></mxCell><mxCell id="c7" value="Limit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEDAFF;strokeColor=#8F7FEE;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="210" height="36" as="geometry"/></mxCell><mxCell id="c8" value="Log a mood check-in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="300" height="36" as="geometry"/></mxCell><mxCell id="c9" value="+10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="156" width="90" height="36" as="geometry"/></mxCell><mxCell id="c10" value="Once per day" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="156" width="210" height="36" as="geometry"/></mxCell><mxCell id="c11" value="Send a chat message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="300" height="36" as="geometry"/></mxCell><mxCell id="c12" value="+2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="192" width="90" height="36" as="geometry"/></mxCell><mxCell id="c13" value="Up to 20 XP per day" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="192" width="210" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Mark an article as read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="300" height="36" as="geometry"/></mxCell><mxCell id="c15" value="+5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="228" width="90" height="36" as="geometry"/></mxCell><mxCell id="c16" value="Once per article" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="228" width="210" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Weekly quest: check in on 5 days" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="300" height="36" as="geometry"/></mxCell><mxCell id="c18" value="+25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="340" y="264" width="90" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Once per week" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F7FEE;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="430" y="264" width="210" height="36" as="geometry"/></mxCell><mxCell id="c20" value="Chat XP is capped so rewards favour healthy habits, not chat volume." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=12;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="600" height="36" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;B. Levels&lt;/b&gt; &lt;span style=&#x27;font-size:12px;color:#595959&#x27;&gt;(total XP needed)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=16;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="860" height="30" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Level 1&lt;/b&gt;&lt;br&gt;0 XP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F2FD;strokeColor=#8F7FEE;fontSize=13;arcSize=15;" vertex="1" parent="1"><mxGeometry x="700" y="125" width="120" height="64" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Level 2&lt;/b&gt;&lt;br&gt;50 XP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F2FD;strokeColor=#8F7FEE;fontSize=13;arcSize=15;" vertex="1" parent="1"><mxGeometry x="840" y="125" width="120" height="64" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Level 3&lt;/b&gt;&lt;br&gt;100 XP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F2FD;strokeColor=#8F7FEE;fontSize=13;arcSize=15;" vertex="1" parent="1"><mxGeometry x="980" y="125" width="120" height="64" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Level 4&lt;/b&gt;&lt;br&gt;200 XP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F2FD;strokeColor=#8F7FEE;fontSize=13;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="125" width="120" height="64" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Level 5&lt;/b&gt;&lt;br&gt;350 XP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F2FD;strokeColor=#8F7FEE;fontSize=13;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1260" y="125" width="120" height="64" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Level 6+&lt;/b&gt;&lt;br&gt;+200 each" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F2FD;strokeColor=#8F7FEE;fontSize=13;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1400" y="125" width="120" height="64" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="Example from the wireframes: 160 XP = Level 3, 60 / 100 into the level, 40 XP to Level 4.&lt;br&gt;Levels never go down. XP and badges are never taken away." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=12;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="700" y="205" width="860" height="52" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;C. Daily streak and check-in XP&lt;/b&gt; &lt;span style=&#x27;font-size:12px;color:#595959&#x27;&gt;(runs when a mood entry is saved; day = Africa/Nairobi time)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1240" height="30" as="geometry"/></mxCell><mxCell id="c35" value="Mood check-in saved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ADF0C7;strokeColor=#067429;fontSize=13;arcSize=40;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="170" height="60" as="geometry"/></mxCell><mxCell id="c36" value="Already checked in today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="395" width="190" height="90" as="geometry"/></mxCell><mxCell id="c37" value="No streak change and no extra XP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="275" y="545" width="180" height="60" as="geometry"/></mxCell><mxCell id="c38" value="Checked in yesterday?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="395" width="190" height="90" as="geometry"/></mxCell><mxCell id="c39" value="Streak + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="370" width="160" height="50" as="geometry"/></mxCell><mxCell id="c40" value="Streak = 1&lt;br&gt;(start again)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="160" height="56" as="geometry"/></mxCell><mxCell id="c41" value="Add 10 XP,&lt;br&gt;update level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="410" width="150" height="60" as="geometry"/></mxCell><mxCell id="c42" value="Check badge rules (section D)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1210" y="410" width="170" height="60" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c36" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c37" target="c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Missed a day?&lt;/b&gt;&lt;br&gt;The streak restarts at 1, but XP, level and badges stay. Workshop participants can review this rule." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5ED;strokeColor=#FE9F4D;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1420" y="370" width="200" height="150" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;D. Badges&lt;/b&gt; &lt;span style=&#x27;font-size:12px;color:#595959&#x27;&gt;(each earned once; a badge alert is shown on the phone)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1240" height="30" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;First Check-in&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#595959&#x27;&gt;1 mood check-in&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="245" height="80" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;First Chat&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#595959&#x27;&gt;1 chat message&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="305" y="695" width="245" height="80" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Curious Mind&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#595959&#x27;&gt;Read 3 articles&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="695" width="245" height="80" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;7-Day Streak&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#595959&#x27;&gt;Streak reaches 7 days&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="835" y="695" width="245" height="80" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Mood Explorer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#595959&#x27;&gt;20 mood check-ins&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="695" width="245" height="80" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Quest Master&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#595959&#x27;&gt;Complete 4 weekly quests&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6B6;strokeColor=#AF7E04;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1365" y="695" width="245" height="80" as="geometry"/></mxCell><mxCell id="c60" value="Rules run in the database after each mood log, chat message or article read, so the same results appear on every device." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1A1A1A;fontSize=12;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="1580" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>